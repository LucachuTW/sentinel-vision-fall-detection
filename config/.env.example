# Runtime-only secret. The API and logs redact URI userinfo.
SV_SOURCE_URI=rtsp://user:password@camera.local:554/stream
SV_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# Bearer token required by the data/metrics API when api.require_auth is true (production).
SV_API_TOKEN=change-me-to-a-long-random-secret

